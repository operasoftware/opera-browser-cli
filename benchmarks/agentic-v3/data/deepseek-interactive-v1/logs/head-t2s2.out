page:
  title: React • TodoMVC
  url: "https://demo.playwright.dev/todomvc"
  snap: "407"
  refs: 10
snapshot:
@.0 root "React • TodoMVC" url="/todomvc/#/"
  @.1 text "This is just a demo of TodoMVC for testing, not the "
  @.2 link "real TodoMVC app." url="https://todomvc.com/"
  @.4 # todos
  @.5 textbox "What needs to be done?" focusable focused
  @.6 contentinfo
    @.7 text "Double-click to edit a todoCreated by "
    @.9 link "Remo H. Jansen" url="http://github.com/remojansen/"
    @.11 text "Part of "
    @.12 link "TodoMVC" url="http://todomvc.com/"
help[4]:
  Run `opera-browser-cli fill @.5 "text"` to fill the "What needs to be done?" field
  Run `opera-browser-cli click @.2` to click the "real TodoMVC app." link
  Run `opera-browser-cli scroll down` to scroll down
  Use `opera-browser-cli eval <expr>` for JS expressions. For multi-statement code, wrap in an IIFE: `eval "(() => { ...; return result })()"`

