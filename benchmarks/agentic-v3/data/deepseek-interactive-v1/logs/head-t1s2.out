  @.7384 text ": The request was received, continuing process"
  @.7385 link "2xx (Successful)" url="/rfc/rfc9110.html#status.2xx"
  @.7387 text ": The request was successfully received, understood, and accepted"
  @.7388 link "3xx (Redirection)" url="/rfc/rfc9110.html#status.3xx"
