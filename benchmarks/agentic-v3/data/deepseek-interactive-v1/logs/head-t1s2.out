  @.8477 link "Content-Range" url=$u7
  @.8479 text " header field specifying the current length of the selected representation ("
  @.8480 link "Section 14.4" url=$u7
  @.8482 text ").For example:"
  @.8484 text "HTTP/1.1 416 Range Not Satisfiable
