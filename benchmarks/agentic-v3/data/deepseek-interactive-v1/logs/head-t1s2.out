  @.6734 text " is not present, and "
  @.6735 link "If-Unmodified-Since" url=$u6
  @.6737 text " is present, evaluate the "
  @.6738 link "If-Unmodified-Since" url=$u6
  @.6740 text " precondition:if true, continue to step "
  @.6742 link "3" url=$u5
  @.6744 text "if false, respond "
  @.6745 link "412 (Precondition Failed)" url=$u3
  @.6747 text " unless it can be determined that the state-changing request has already succeeded (see "
  @.6748 link "Section 13.1.4" url=$u6
  @.6750 text ")When "
  @.6752 link "If-None-Match" url=$u7
  @.6754 text " is present, evaluate the "
