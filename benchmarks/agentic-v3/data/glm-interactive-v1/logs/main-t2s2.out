snapshot:
@14.0 root "React • TodoMVC" url="/todomvc/#/"
  @14.1 text "This is just a demo of TodoMVC for testing, not the "
  @14.2 link "real TodoMVC app." url="https://todomvc.com/"
  @14.4 # todos
  @14.5 textbox "What needs to be done?" focusable focused
  @14.6 contentinfo
    @14.7 text "Double-click to edit a todoCreated by "
