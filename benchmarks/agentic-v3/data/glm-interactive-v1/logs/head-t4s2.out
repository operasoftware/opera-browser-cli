page:
  title: List of chemical elements - Wikipedia
  url: "https://en.wikipedia.org/wiki/List_of_chemical_elements"
  snap: "20"
  refs: 1448
snapshot:
@.0 root "List of chemical elements - Wikipedia" url=$u1
  @.1 generic live="polite"
  @.2 link "Jump to content" url="/wiki/List_of_chemical_elements#bodyContent"
  @.4 banner
    @.5 navigation "Site"
      @.6 button "Main menu" haspopup="menu"
    @.7 link "Wikipedia The Free Encyclopedia" url="/wiki/Main_Page"
      @.8 image "Wikipedia" url="/static/images/mobile/copyright/wikipedia-wordmark-en-25.svg"
      @.9 image "The Free Encyclopedia" url="/static/images/mobile/copyright/wikipedia-tagline-en-25.svg"
    @.10 search
      @.11 form
        @.12 searchbox "Search Wikipedia" description="Search Wikipedia [ctrl-option-f]" keyshortcuts="Ctrl+Alt+f"
        @.13 button "Search"
    @.14 navigation "Personal tools"
      @.15 link "Donate" url="https://donate.wikimedia.org/?wmf_source=donate&wmf_medium=sidebar&wmf_campaign=en.wikipedia.org&uselang=en"
      @.17 link "Create account" description="You are encouraged to create an account and log in; however, it is not mandatory" url="/w/index.php?title=Special:CreateAccount&returnto=List+of+chemical+elements"
